<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SubHub | Gestiona todas tus suscripciones</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Inter, Arial, sans-serif;
            background: #0b1020;
            color: #f5f7ff;
        }

        button {
            font-family: inherit;
        }

        /* SIDEBAR */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 240px;
            height: 100vh;
            background: #11182b;
            border-right: 1px solid #202a43;
            padding: 28px 18px;
        }

        .logo {
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 45px;
            padding-left: 12px;
        }

        .logo span {
            color: #7c6cff;
        }

        .menu {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .menu a {
            text-decoration: none;
            color: #8e99b5;
            padding: 13px 14px;
            border-radius: 10px;
            font-size: 14px;
            transition: .2s;
        }

        .menu a:hover,
        .menu a.active {
            background: #1d2640;
            color: white;
        }

        /* MAIN */

        .main {
            margin-left: 240px;
            padding: 32px 40px;
            max-width: 1500px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 35px;
        }

        .welcome h1 {
            font-size: 27px;
            margin-bottom: 7px;
        }

        .welcome p {
            color: #8e99b5;
            font-size: 14px;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #7c6cff;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
        }

        /* CARDS */

        .summary {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin-bottom: 25px;
        }

        .card {
            background: #11182b;
            border: 1px solid #202a43;
            border-radius: 16px;
            padding: 22px;
        }

        .card-label {
            color: #8e99b5;
            font-size: 13px;
            margin-bottom: 12px;
        }

        .card-value {
            font-size: 27px;
            font-weight: 700;
        }

        .card-small {
            color: #6f7b99;
            font-size: 12px;
            margin-top: 8px;
        }

        .positive {
            color: #55d89b;
        }

        /* GRID */

        .content-grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 20px;
        }

        .section {
            background: #11182b;
            border: 1px solid #202a43;
            border-radius: 16px;
            padding: 22px;
            margin-bottom: 20px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .section-header h2 {
            font-size: 17px;
        }

        .section-header a {
            color: #8c82ff;
            font-size: 13px;
            text-decoration: none;
        }

        /* SUBSCRIPTIONS */

        .subscription {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 0;
            border-bottom: 1px solid #202a43;
        }

        .subscription:last-child {
            border-bottom: none;
        }

        .service-info {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .service-icon {
            width: 43px;
            height: 43px;
            border-radius: 12px;
            background: #202a43;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .service-name {
            font-weight: 600;
            font-size: 14px;
        }

        .service-type {
            color: #77829f;
            font-size: 12px;
            margin-top: 4px;
        }

        .price {
            text-align: right;
        }

        .price strong {
            font-size: 14px;
        }

        .price small {
            display: block;
            color: #77829f;
            margin-top: 4px;
        }

        /* UPCOMING */

        .payment {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 0;
            border-bottom: 1px solid #202a43;
        }

        .payment:last-child {
            border-bottom: none;
        }

        .date {
            width: 45px;
            height: 45px;
            border-radius: 10px;
            background: #202a43;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            margin-right: 12px;
        }

        .date strong {
            font-size: 15px;
        }

        .date span {
            font-size: 9px;
            color: #8e99b5;
        }

        .payment-left {
            display: flex;
            align-items: center;
        }

        /* CARD PAYMENT */

        .bank-card {
            background: linear-gradient(135deg, #5146b9, #27235d);
            border-radius: 15px;
            padding: 20px;
            min-height: 145px;
            position: relative;
            overflow: hidden;
        }

        .bank-card::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            border: 25px solid rgba(255,255,255,.06);
            right: -50px;
            top: -50px;
        }

        .bank-name {
            font-size: 13px;
            opacity: .8;
        }

        .card-number {
            margin-top: 35px;
            font-size: 17px;
            letter-spacing: 2px;
        }

        .card-bottom {
            display: flex;
            justify-content: space-between;
            margin-top: 15px;
            font-size: 11px;
            opacity: .8;
        }

        /* OFFERS */

        .offer {
            border: 1px solid #293454;
            border-radius: 13px;
            padding: 15px;
            margin-bottom: 12px;
        }

        .offer:last-child {
            margin-bottom: 0;
        }

        .offer-title {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .discount {
            color: #55d89b;
            font-size: 12px;
            font-weight: bold;
        }

        .offer p {
            color: #8994b0;
            font-size: 12px;
            margin-bottom: 12px;
        }

        .offer button {
            border: none;
            background: #7c6cff;
            color: white;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 12px;
            cursor: pointer;
        }

        /* BUTTON */

        .primary-btn {
            background: #7c6cff;
            border: none;
            color: white;
            padding: 11px 17px;
            border-radius: 9px;
            cursor: pointer;
            font-weight: 600;
        }

        .primary-btn:hover {
            opacity: .85;
        }

        /* RESPONSIVE */

        @media(max-width: 1000px) {

            .sidebar {
                width: 190px;
            }

            .main {
                margin-left: 190px;
                padding: 25px;
            }

            .summary {
                grid-template-columns: repeat(2, 1fr);
            }

            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        @media(max-width: 650px) {

            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 20px;
            }

            .summary {
                grid-template-columns: 1fr;
            }

            .topbar {
                align-items: flex-start;
            }
        }
    </style>
</head>

